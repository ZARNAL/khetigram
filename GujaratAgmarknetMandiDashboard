        function getGujaratiName(text) {
            if (!text) return '';
            const lower = text.toLowerCase().trim();
            if (EN_TO_GU[lower]) return EN_TO_GU[lower];
            for (const [key, gu] of Object.entries(EN_TO_GU)) {
                if (lower.includes(key)) return gu;
            }
            return text;
        }

        function getCropIcon(commodity) {
            const lower = (commodity || '').toLowerCase();
            const match = CROP_DICTIONARY.find(c => c.keywords.some(k => lower.includes(k)));
            return match ? match.icon : '🌾';
        }

