        function formatDateDDMMYYYY(dateObj) {
            const dd = String(dateObj.getDate()).padStart(2, '0');
            const mm = String(dateObj.getMonth() + 1).padStart(2, '0');
            const yyyy = dateObj.getFullYear();
            return `${dd}/${mm}/${yyyy}`;
        }

        function formatDateYYYYMMDD(dateObj) {
            const dd = String(dateObj.getDate()).padStart(2, '0');
            const mm = String(dateObj.getMonth() + 1).padStart(2, '0');
            const yyyy = dateObj.getFullYear();
            return `${yyyy}-${mm}-${dd}`;
        }

        function isoToDDMMYYYY(isoStr) {
            if (!isoStr || !isoStr.includes('-')) return isoStr;
            const [y, m, d] = isoStr.split('-');
            return `${d}/${m}/${y}`;
        }

        function normalizeArrivalDate(rawDate) {
            if (!rawDate) return 'આજ';
            const str = String(rawDate).trim();
            if (/^\d{4}-\d{2}-\d{2}/.test(str)) {
                const [y, m, d] = str.slice(0, 10).split('-');
                return `${d}/${m}/${y}`;
            }
            return str;
        }

        function normalizeRecord(rec, index = 0) {
            const minP = parseFloat(rec.min_price ?? rec.Min_Price) || 0;
            const maxP = parseFloat(rec.max_price ?? rec.Max_Price) || 0;
            const modalP = parseFloat(rec.modal_price ?? rec.Modal_Price) || Math.round((minP + maxP) / 2);

            return {
                id: index + 1,
                state: String(rec.state ?? rec.State ?? 'Gujarat').trim(),
                district: String(rec.district ?? rec.District ?? 'Unknown').trim(),
                market: String(rec.market ?? rec.Market ?? 'Unknown').trim(),
                commodity: String(rec.commodity ?? rec.Commodity ?? 'Unknown').trim(),
                variety: String(rec.variety ?? rec.Variety ?? 'સામાન્ય').trim(),
                arrival_date: normalizeArrivalDate(rec.arrival_date ?? rec.Arrival_Date),
                min_price: minP,
                max_price: maxP,
                modal_price: modalP
            };
        }

        function buildMultiDayFallbackData(customCenterDate = null) {
            const baseTemplates = [
                { district: "Rajkot", market: "Gondal", commodity: "Groundnut", variety: "Bold (G-20)", min: 5200, max: 6650, modal: 6150 },
                { district: "Rajkot", market: "Rajkot", commodity: "Cotton", variety: "Shankar-6", min: 6900, max: 7850, modal: 7480 },
                { district: "Rajkot", market: "Jasdan", commodity: "Groundnut", variety: "G-20", min: 5150, max: 6500, modal: 6020 },
                { district: "Mehsana", market: "Unjha", commodity: "Cumin Seed(Jeera)", variety: "Eagle", min: 21500, max: 26200, modal: 24100 },
                { district: "Mehsana", market: "Unjha", commodity: "Fennel", variety: "Green", min: 8200, max: 11800, modal: 10200 },
                { district: "Bhavnagar", market: "Mahuva", commodity: "Onion", variety: "Red", min: 950, max: 2150, modal: 1620 },
                { district: "Banaskantha", market: "Deesa", commodity: "Potato", variety: "Pukhraj", min: 900, max: 1650, modal: 1320 },
                { district: "Junagadh", market: "Junagadh", commodity: "Wheat", variety: "Lokwan", min: 2450, max: 2980, modal: 2740 },
                { district: "Amreli", market: "Amreli", commodity: "Sesamum(Sesame,Gingelly,Til)", variety: "White", min: 10800, max: 13400, modal: 12250 },
                { district: "Jamnagar", market: "Jamnagar", commodity: "Coriander seed", variety: "Eagle", min: 6400, max: 7900, modal: 7250 },
                { district: "Banaskantha", market: "Palanpur", commodity: "Castor Seed", variety: "Hybrid", min: 5650, max: 6150, modal: 5940 },
                { district: "Ahmedabad", market: "Ahmedabad", commodity: "Tomato", variety: "Hybrid", min: 1100, max: 2400, modal: 1750 },
                { district: "Surat", market: "Surat", commodity: "Brinjal", variety: "Local", min: 1400, max: 2600, modal: 2050 },
                { district: "Anand", market: "Anand", commodity: "Banana", variety: "Robusta", min: 1200, max: 2100, modal: 1680 },
                { district: "Junagadh", market: "Junagadh", commodity: "Mango", variety: "Kesar", min: 4500, max: 8500, modal: 6400 },
                { district: "Rajkot", market: "Gondal", commodity: "Bengal Gram(Gram)(Whole)", variety: "Desi", min: 5400, max: 6250, modal: 5850 },
                { district: "Vadodara", market: "Vadodara", commodity: "Arhar (Tur/Red Gram)(Whole)", variety: "Red", min: 7600, max: 9100, modal: 8450 },
                { district: "Surat", market: "Surat", commodity: "Coriander(Leaves)", variety: "Green", min: 1800, max: 3200, modal: 2500 },
                { district: "Ahmedabad", market: "Ahmedabad", commodity: "Spinach", variety: "Fresh", min: 900, max: 1600, modal: 1250 },
                { district: "Kachchh", market: "Bhuj", commodity: "Bajra(Pearl Millet/Cumbu)", variety: "Desi", min: 2200, max: 2750, modal: 2480 }
            ];

            const generated = [];
            let idx = 1;
            const anchorDate = customCenterDate || new Date();
            const dayOffsets = customCenterDate ? [0] : [0, 1, 2, 3, 4, 5, 6];

            dayOffsets.forEach(daysAgo => {
                const d = new Date(anchorDate);
                d.setDate(d.getDate() - daysAgo);
                const dateStr = formatDateDDMMYYYY(d);
                const seedFactor = (d.getDate() + d.getMonth() * 3) % 7;

                baseTemplates.forEach((item, itemIdx) => {
                    const wave = Math.sin(seedFactor + itemIdx * 0.7) * 0.04;
                    const factor = 1 + wave;
                    generated.push({
                        id: idx++,
                        state: 'Gujarat',
                        district: item.district,
                        market: item.market,
                        commodity: item.commodity,
                        variety: item.variety,
                        arrival_date: dateStr,
                        min_price: Math.round((item.min * factor) / 10) * 10,
                        max_price: Math.round((item.max * factor) / 10) * 10,
                        modal_price: Math.round((item.modal * factor) / 10) * 10
                    });
                });
            });
            return generated;
        }

