            if (els.selectedCropHeroBanner) {
                if (isSingleCropSelected) {
                    els.selectedCropHeroIcon.textContent = selectedCropObj.icon;
                    els.selectedCropHeroTitle.textContent = `${selectedCropObj.gu} ના ભાવ`;
                    els.selectedCropHeroBanner.classList.remove('hidden');
                } else if (selectedCatObj) {
                    els.selectedCropHeroIcon.textContent = selectedCatObj.icon;
                    els.selectedCropHeroTitle.textContent = `${selectedCatObj.gu} ના ભાવ`;
                    els.selectedCropHeroBanner.classList.remove('hidden');
                } else {
                    els.selectedCropHeroBanner.classList.add('hidden');
                }
            }

            els.tableSummaryText.textContent = `કુલ ${totalRows} ભાવ બતાવે છે`;

            if (totalRows === 0) {
                els.farmerCardsGrid.innerHTML = '';
                els.emptyTableState.classList.remove('hidden');
            } else {
                els.emptyTableState.classList.add('hidden');
                els.farmerCardsGrid.innerHTML = pageRows.map((rec, localIdx) => {
                    const globalIdx = startIdx + localIdx;
                    const icon = getCropIcon(rec.commodity);
                    const guCrop = getGujaratiName(rec.commodity);
                    const guMarket = getGujaratiName(rec.market);
                    const guDistrict = getGujaratiName(rec.district);
                    const varietyLabel = (rec.variety && rec.variety !== 'Other' && rec.variety !== 'સામાન્ય') ? rec.variety : 'સામાન્ય';

                    const primaryTitle = isSingleCropSelected ? `${guMarket} યાર્ડ` : guCrop;
                    const secondaryBadge = isSingleCropSelected
                        ? `<span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-bold bg-[#F0F7FF] text-[#0071E3] border border-[#0071E3]/15">${varietyLabel}</span>`
                        : `<span class="text-xs text-[#6E6E73] font-bold truncate">🏛️ ${guMarket} • ${guDistrict}</span>`;

                    const subMetaText = isSingleCropSelected
