                    return `
                        <article class="bg-white rounded-3xl border border-black/[0.06] shadow-apple p-4 flex flex-col justify-between gap-3 transition-transform active:scale-[0.99]">
                            <div class="flex items-start justify-between gap-2.5">
                                <div class="flex items-center gap-3 min-w-0">
                                    <div class="w-11 h-11 rounded-2xl bg-[#F5F5F7] flex items-center justify-center text-2xl shrink-0">
                                        ${icon}
                                    </div>
                                    <div class="min-w-0 space-y-0.5">
                                        <div class="flex items-center gap-2 flex-wrap">
                                            <h3 class="text-base sm:text-lg font-black text-[#1D1D1F] leading-tight truncate">${primaryTitle}</h3>
                                            ${isSingleCropSelected ? secondaryBadge : ''}
                                        </div>
                                        ${!isSingleCropSelected ? `<div class="truncate">${secondaryBadge}</div>` : ''}
                                        <p class="text-[11px] text-[#86868B] font-semibold truncate">${subMetaText}</p>
                                    </div>
                                </div>
                                <button type="button" onclick="speakSingleRecord(${globalIdx})" class="shrink-0 w-9 h-9 rounded-full bg-[#F5F5F7] hover:bg-[#E8E8ED] text-[#0071E3] flex items-center justify-center text-base active:scale-90" title="ભાવ સાંભળો">
                                    🔊
                                </button>
                            </div>

                            <div class="grid grid-cols-3 gap-1.5 bg-[#F5F5F7] p-2 rounded-2xl text-center">
                                <div class="py-1 px-1">
                                    <span class="block text-[11px] font-bold text-[#6E6E73]">ઓછો</span>
                                    <span class="text-sm sm:text-base font-extrabold text-[#1D1D1F] tabular-nums">₹${formatPrice(rec.min_price)}</span>
                                </div>
                                <div class="py-1 px-1 bg-white rounded-xl shadow-sm">
                                    <span class="block text-[11px] font-extrabold text-[#0071E3]">સરેરાશ</span>
                                    <span class="text-base sm:text-lg font-black text-[#1D1D1F] tabular-nums">₹${formatPrice(rec.modal_price)}</span>
                                </div>
                                <div class="py-1 px-1">
                                    <span class="block text-[11px] font-bold text-[#248A3D]">ઊંચો</span>
                                    <span class="text-sm sm:text-base font-extrabold text-[#248A3D] tabular-nums">₹${formatPrice(rec.max_price)}</span>
                                </div>
                            </div>
                        </article>
                    `;
                }).join('');
            }

            renderPagination(totalPages);
        }

        function renderPagination(totalPages) {
            if (totalPages <= 1) {
                els.paginationControls.innerHTML = `<span class="text-xs font-bold text-[#6E6E73]">પાનું ૧ / ૧</span>`;
                return;
            }
            const prevDisabled = state.currentPage === 1 ? 'opacity-40 pointer-events-none' : '';
            const nextDisabled = state.currentPage === totalPages ? 'opacity-40 pointer-events-none' : '';

            els.paginationControls.innerHTML = `
                <button onclick="goToPage(${state.currentPage - 1})" class="px-3.5 py-1.5 text-xs font-extrabold rounded-full bg-[#F5F5F7] text-[#1D1D1F] ${prevDisabled}">‹ પાછળ</button>
                <span class="text-xs font-extrabold text-[#1D1D1F] px-1">${state.currentPage} / ${totalPages}</span>
                <button onclick="goToPage(${state.currentPage + 1})" class="px-3.5 py-1.5 text-xs font-extrabold rounded-full bg-[#1D1D1F] text-white ${nextDisabled}">આગળ ›</button>
            `;
        }

        window.goToPage = function(page) {
            state.currentPage = page;
            renderCards();
            window.scrollTo({ top: 180, behavior: 'smooth' });
        };

        /* =====================================================================
           YARD DIRECTORY VIEW (યાર્ડ મુજબ)
           ===================================================================== */
        function getMarketRegion(district) {
            return DISTRICT_REGION_MAP[district] || 'Saurashtra';
        }

        function toggleFavoriteYard(marketName) {
            const idx = state.favoriteYards.indexOf(marketName);
            if (idx >= 0) state.favoriteYards.splice(idx, 1);
            else state.favoriteYards.push(marketName);
            localStorage.setItem('guj_mandi_fav_yards', JSON.stringify(state.favoriteYards));
            renderKhetiGramView();
        }

        window.openKhetiGramYard = function(marketName) {
            state.kgSelectedYard = marketName;
            renderKhetiGramView();
        };

        window.toggleKgFav = function(e, marketName) {
            e.stopPropagation();
            toggleFavoriteYard(marketName);
        };

        function renderKhetiGramView() {
            const searchQ = (els.kgSearchInput?.value || '').trim().toLowerCase();

            document.querySelectorAll('.kg-region-pill').forEach(btn => {
                const isActive = btn.dataset.region === state.kgRegion;
                btn.className = isActive
                    ? 'kg-region-pill shrink-0 px-3.5 py-1.5 rounded-full text-xs font-extrabold bg-[#1D1D1F] text-white'
                    : 'kg-region-pill shrink-0 px-3.5 py-1.5 rounded-full text-xs font-bold bg-[#F5F5F7] text-[#1D1D1F]';
            });

            if (state.kgSelectedYard) {
                els.kgYardDirectoryScreen.classList.add('hidden');
                els.kgYardDetailScreen.classList.remove('hidden');
                els.kgBackToYardsBtn.classList.remove('hidden');

                const yardRecords = state.rawRecords.filter(r => r.market === state.kgSelectedYard);
                const firstRec = yardRecords[0] || { market: state.kgSelectedYard, district: 'Gujarat', arrival_date: '' };
                const isFav = state.favoriteYards.includes(state.kgSelectedYard);

                els.kgSelectedYardTitle.textContent = `${getGujaratiName(firstRec.market)} માર્કેટ યાર્ડ`;
                els.kgSelectedYardMeta.textContent = `જિલ્લો: ${getGujaratiName(firstRec.district)} • ${firstRec.arrival_date}`;
                els.kgToggleFavDetailBtn.textContent = isFav ? '⭐' : '☆';

                els.kgYardRatesTbody.innerHTML = yardRecords.map(r => `
                    <tr class="hover:bg-[#F5F5F7]/60">
                        <td class="py-3 px-4">
                            <div class="flex items-center gap-2">
                                <span class="text-xl">${getCropIcon(r.commodity)}</span>
                                <span class="font-extrabold text-[#1D1D1F] text-sm">${getGujaratiName(r.commodity)}</span>
                            </div>
                        </td>
                        <td class="py-3 px-2 text-right font-bold text-[#6E6E73]">₹${formatPrice(r.min_price)}</td>
                        <td class="py-3 px-2 text-right font-black text-[#1D1D1F] text-base">₹${formatPrice(r.modal_price)}</td>
                        <td class="py-3 px-4 text-right font-extrabold text-[#248A3D]">₹${formatPrice(r.max_price)}</td>
                    </tr>
                `).join('');
                return;
            }

            els.kgYardDirectoryScreen.classList.remove('hidden');
            els.kgYardDetailScreen.classList.add('hidden');
            els.kgBackToYardsBtn.classList.add('hidden');

            const yardMap = new Map();
            state.rawRecords.forEach(r => {
                if (!yardMap.has(r.market)) {
                    yardMap.set(r.market, {
                        market: r.market,
                        district: r.district,
                        region: getMarketRegion(r.district),
                        commodities: new Set()
                    });
                }
                yardMap.get(r.market).commodities.add(r.commodity);
            });

            let yards = Array.from(yardMap.values()).filter(y => {
                if (state.kgRegion === 'FAV' && !state.favoriteYards.includes(y.market)) return false;
                if (state.kgRegion !== 'ALL' && state.kgRegion !== 'FAV' && y.region !== state.kgRegion) return false;
                if (searchQ) {
                    const guM = getGujaratiName(y.market).toLowerCase();
                    const guD = getGujaratiName(y.district).toLowerCase();
                    if (!y.market.toLowerCase().includes(searchQ) && !y.district.toLowerCase().includes(searchQ) && !guM.includes(searchQ) && !guD.includes(searchQ)) {
                        return false;
                    }
                }
                return true;
            });

            yards.sort((a, b) => {
                const aFav = state.favoriteYards.includes(a.market) ? 0 : 1;
                const bFav = state.favoriteYards.includes(b.market) ? 0 : 1;
                if (aFav !== bFav) return aFav - bFav;
                return a.market.localeCompare(b.market);
            });

            if (yards.length === 0) {
                els.kgYardDirectoryScreen.innerHTML = `<div class="p-10 text-center text-sm font-bold text-[#6E6E73]">કોઈ યાર્ડ મળ્યું નથી.</div>`;
                return;
            }

            els.kgYardDirectoryScreen.innerHTML = yards.map(y => {
                const isFav = state.favoriteYards.includes(y.market);
                return `
                    <div onclick="openKhetiGramYard('${y.market.replace(/'/g, "\\'")}')" class="p-4 hover:bg-[#F5F5F7] cursor-pointer flex items-center justify-between gap-3 active:bg-[#E8E8ED]">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-11 h-11 rounded-2xl bg-[#E8F8ED] text-[#248A3D] font-black text-base flex items-center justify-center shrink-0">
                                🏛️
                            </div>
                            <div class="min-w-0">
                                <h4 class="text-base font-black text-[#1D1D1F] truncate">${getGujaratiName(y.market)} યાર્ડ</h4>
                                <p class="text-xs text-[#6E6E73] font-semibold truncate">જિલ્લો: ${getGujaratiName(y.district)} • ${y.commodities.size} પાક</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            <button type="button" onclick="toggleKgFav(event, '${y.market.replace(/'/g, "\\'")}')" class="text-xl p-1.5 rounded-full">
                                ${isFav ? '⭐' : '☆'}
                            </button>
                            <span class="text-[#86868B] font-bold text-xl">›</span>
                        </div>
                    </div>
                `;
            }).join('');
        }

