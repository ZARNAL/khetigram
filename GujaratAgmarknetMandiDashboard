    <script>
        const LIVE_API_BASE = 'https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070';
        const HISTORICAL_API_BASE = 'https://api.data.gov.in/resource/35985678-0d79-46b4-9ed6-6f13308a1d24';
        const DEFAULT_API_KEY = '579b464db66ec23bdd0000017185aa4a01fb494e47104dff02edf1ba';

        const state = {
            rawRecords: [],
            filteredRecords: [],
            currentPage: 1,
            rowsPerPage: 12,
            sortKey: 'modal_price',
            sortDirection: 'desc',
            activeMode: 'live',
            priceUnit: 'mann', // 'mann' (20 kg) default for Gujarat farmers
            uiViewMode: 'dashboard',
            kgRegion: 'ALL',
            kgSelectedYard: null,
            favoriteYards: JSON.parse(localStorage.getItem('guj_mandi_fav_yards') || '["Gondal", "Rajkot", "Jasdan", "Unjha"]'),
            selectedCategory: 'ALL',
            filters: {
                district: '',
                market: '',
                cropKeyword: ''
            }
        };

        const CROP_CATEGORIES = [
            { id: 'ALL', gu: 'બધા પાક', icon: '🌾' },
            { id: 'બીજ', gu: 'બીજ', icon: '🥜' },
            { id: 'મસાલા', gu: 'મસાલા', icon: '🌿' },
            { id: 'શાકભાજી', gu: 'શાકભાજી', icon: '🥔' },
            { id: 'પાંદડાવાળી શાકભાજી', gu: 'પાંદડાવાળી શાકભાજી', icon: '🥬' },
            { id: 'દાળ', gu: 'દાળ', icon: '🫘' },
            { id: 'અનાજ', gu: 'અનાજ', icon: '🌾' },
