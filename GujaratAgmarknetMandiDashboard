        function showBanner(title, message) {
            els.alertTitle.textContent = title;
            els.alertMessage.textContent = message;
            els.alertBanner.classList.remove('hidden');
        }

        function hideBanner() {
            els.alertBanner.classList.add('hidden');
        }

        async function fetchHistoricalByDate(ddmmyyyy, yyyymmdd) {
            const buildHistUrl = (dateVal) => {
                const u = new URL(HISTORICAL_API_BASE);
                u.searchParams.set('api-key', DEFAULT_API_KEY);
                u.searchParams.set('format', 'json');
                u.searchParams.set('limit', '1000');
                u.searchParams.set('filters[State]', 'Gujarat');
                u.searchParams.set('filters[Arrival_Date]', dateVal);
                return u.toString();
            };

            try {
                const res1 = await fetch(buildHistUrl(ddmmyyyy));
                if (res1.ok) {
                    const data1 = await res1.json();
                    if (Array.isArray(data1.records) && data1.records.length > 0) return data1.records;
                }
            } catch (e) {}

            try {
                const res2 = await fetch(buildHistUrl(yyyymmdd));
                if (res2.ok) {
                    const data2 = await res2.json();
                    if (Array.isArray(data2.records) && data2.records.length > 0) return data2.records;
                }
            } catch (e) {}

            try {
                const liveCheckUrl = new URL(LIVE_API_BASE);
                liveCheckUrl.searchParams.set('api-key', DEFAULT_API_KEY);
                liveCheckUrl.searchParams.set('format', 'json');
                liveCheckUrl.searchParams.set('limit', '1500');
                liveCheckUrl.searchParams.set('filters[state]', 'Gujarat');
                const resLive = await fetch(liveCheckUrl.toString());
                if (resLive.ok) {
                    const dataLive = await resLive.json();
                    if (Array.isArray(dataLive.records)) {
                        const matched = dataLive.records.filter(r => {
                            const ad = normalizeArrivalDate(r.arrival_date ?? r.Arrival_Date);
                            return ad === ddmmyyyy;
                        });
                        if (matched.length > 0) return matched;
                    }
                }
            } catch (e) {}

            return [];
        }

        async function loadMandiData(mode = 'live', customIsoDate = null) {
            setDatePillActive(mode);
            els.refreshIcon.classList.add('animate-spin');
            els.loadingState.classList.remove('hidden');
            els.dashboardContent.classList.add('hidden');
            hideBanner();

            let targetDateObj = new Date();
            if (mode === 'yesterday') targetDateObj = getDateDaysAgo(1);
            else if (mode === 'two_days_ago') targetDateObj = getDateDaysAgo(2);
            else if (mode === 'specific_date' && customIsoDate) {
                const [y, m, d] = customIsoDate.split('-').map(Number);
                targetDateObj = new Date(y, m - 1, d);
            }

            if (els.specificDateInput && mode !== 'specific_date') {
                els.specificDateInput.value = formatDateYYYYMMDD(targetDateObj);
            }
            updateDateSubtitle();

            try {
                let fetchedRecords = [];

                if (mode === 'live') {
                    const liveUrl = new URL(LIVE_API_BASE);
                    liveUrl.searchParams.set('api-key', DEFAULT_API_KEY);
                    liveUrl.searchParams.set('format', 'json');
                    liveUrl.searchParams.set('limit', '2000');
                    liveUrl.searchParams.set('offset', '0');
                    liveUrl.searchParams.set('filters[state]', 'Gujarat');

                    const response = await fetch(liveUrl.toString());
                    if (!response.ok) throw new Error(`HTTP ${response.status}`);
                    const data = await response.json();
                    if (Array.isArray(data.records)) fetchedRecords = data.records;
                } else {
                    const ddmmyyyy = formatDateDDMMYYYY(targetDateObj);
                    const yyyymmdd = formatDateYYYYMMDD(targetDateObj);
                    fetchedRecords = await fetchHistoricalByDate(ddmmyyyy, yyyymmdd);
                }

                if (!fetchedRecords || fetchedRecords.length === 0) {
                    throw new Error('NO_RECORDS_FOR_DATE');
                }

                state.rawRecords = fetchedRecords.map((r, i) => normalizeRecord(r, i));

                els.dataStatusBadge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-[#34C759] animate-pulse"></span> તાજો`;
                els.dataStatusBadge.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-[#E8F8ED] text-[#1E7E34] shrink-0';

            } catch (err) {
                const fallbackAll = buildMultiDayFallbackData(mode === 'live' ? null : targetDateObj);
                const targetStr = formatDateDDMMYYYY(targetDateObj);
                const exactDay = fallbackAll.filter(r => r.arrival_date === targetStr);
                state.rawRecords = exactDay.length ? exactDay : fallbackAll.filter(r => r.arrival_date === fallbackAll[0].arrival_date);

                els.dataStatusBadge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> અંદાજિત`;
                els.dataStatusBadge.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-amber-50 text-amber-800 shrink-0';

                showBanner('નોંધ:', `${formatDateDDMMYYYY(targetDateObj)} ના સરકારી ભાવ હજુ અપલોડ થયા નથી, તેથી અંદાજિત ભાવ બતાવ્યા છે.`);
            } finally {
                els.refreshIcon.classList.remove('animate-spin');
                els.loadingState.classList.add('hidden');
                els.dashboardContent.classList.remove('hidden');

                populateFilterDropdowns();
                applyFiltersAndRender();
                if (state.uiViewMode === 'khetigram') renderKhetiGramView();
            }
        }

        function populateFilterDropdowns() {
            const districts = [...new Set(state.rawRecords.map(r => r.district))].sort();
            els.districtFilter.innerHTML = '<option value="">📍 બધા જિલ્લા</option>' +
                districts.map(d => `<option value="${d}" ${state.filters.district === d ? 'selected' : ''}>${getGujaratiName(d)}</option>`).join('');

            updateCascadingDropdowns();
        }

        function updateCascadingDropdowns() {
            const dist = state.filters.district;
            const subset = dist ? state.rawRecords.filter(r => r.district === dist) : state.rawRecords;

            const markets = [...new Set(subset.map(r => r.market))].sort();
            els.marketFilter.innerHTML = '<option value="">🏛️ બધા માર્કેટ યાર્ડ</option>' +
                markets.map(m => `<option value="${m}" ${state.filters.market === m ? 'selected' : ''}>${getGujaratiName(m)}</option>`).join('');
        }

        function applyFiltersAndRender() {
            const cropObj = CROP_DICTIONARY.find(c => c.id === state.filters.cropKeyword);
            const activeCategory = state.selectedCategory;

            const hasActiveFilters = Boolean(cropObj || activeCategory !== 'ALL' || state.filters.district || state.filters.market);
            if (els.resetFiltersBtn) {
                els.resetFiltersBtn.classList.toggle('hidden', !hasActiveFilters);
            }
            if (els.activeFilterDot) {
                els.activeFilterDot.classList.toggle('hidden', !(state.filters.district || state.filters.market));
            }

            state.filteredRecords = state.rawRecords.filter(rec => {
                if (state.filters.district && rec.district !== state.filters.district) return false;
                if (state.filters.market && rec.market !== state.filters.market) return false;

                const commLower = rec.commodity.toLowerCase();

                if (cropObj) {
                    if (!cropObj.keywords.some(k => commLower.includes(k))) return false;
                } else if (activeCategory !== 'ALL') {
                    const catCrops = CROP_DICTIONARY.filter(c => c.category === activeCategory);
                    const matchesCategory = catCrops.some(c => c.keywords.some(k => commLower.includes(k)));
                    if (!matchesCategory) return false;
                }

                return true;
            });

            const dir = state.sortDirection === 'asc' ? 1 : -1;
            state.filteredRecords.sort((a, b) => {
                const valA = a[state.sortKey];
                const valB = b[state.sortKey];
                if (typeof valA === 'number' && typeof valB === 'number') return (valA - valB) * dir;
                return String(valA).localeCompare(String(valB)) * dir;
            });

            renderCards();
        }

        function renderCards() {
            const totalRows = state.filteredRecords.length;
            const totalPages = Math.max(1, Math.ceil(totalRows / state.rowsPerPage));
            if (state.currentPage > totalPages) state.currentPage = totalPages;

            const startIdx = (state.currentPage - 1) * state.rowsPerPage;
            const pageRows = state.filteredRecords.slice(startIdx, startIdx + state.rowsPerPage);

            const selectedCropObj = CROP_DICTIONARY.find(c => c.id === state.filters.cropKeyword);
            const selectedCatObj = CROP_CATEGORIES.find(c => c.id === state.selectedCategory && c.id !== 'ALL');
