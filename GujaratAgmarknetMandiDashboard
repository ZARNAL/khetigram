            if (els.resetFiltersBtn) {
                els.resetFiltersBtn.addEventListener('click', () => {
                    state.selectedCategory = 'ALL';
                    state.filters = { district: '', market: '', cropKeyword: '' };
                    state.currentPage = 1;
                    populateFilterDropdowns();
                    renderVisualCropButtons();
                    applyFiltersAndRender();
                });
            }

            if (els.simpleSortSelect) {
                els.simpleSortSelect.addEventListener('change', () => {
                    const val = els.simpleSortSelect.value;
                    if (val === 'modal_desc') { state.sortKey = 'modal_price'; state.sortDirection = 'desc'; }
                    else if (val === 'modal_asc') { state.sortKey = 'modal_price'; state.sortDirection = 'asc'; }
                    else if (val === 'market_asc') { state.sortKey = 'market'; state.sortDirection = 'asc'; }
                    state.currentPage = 1;
                    applyFiltersAndRender();
                });
            }

            if (els.refreshDataBtn) {
                els.refreshDataBtn.addEventListener('click', () => {
                    loadMandiData(state.activeMode, els.specificDateInput?.value || null);
                });
            }

            if (els.kgSearchInput) els.kgSearchInput.addEventListener('input', renderKhetiGramView);
            document.querySelectorAll('.kg-region-pill').forEach(btn => {
                btn.addEventListener('click', () => {
                    state.kgRegion = btn.dataset.region;
                    state.kgSelectedYard = null;
                    renderKhetiGramView();
                });
            });

            const closeYardDetail = () => { state.kgSelectedYard = null; renderKhetiGramView(); };
            if (els.kgBackToYardsBtn) els.kgBackToYardsBtn.addEventListener('click', closeYardDetail);
            if (els.kgBottomBackBtn) els.kgBottomBackBtn.addEventListener('click', closeYardDetail);

            if (els.kgToggleFavDetailBtn) {
                els.kgToggleFavDetailBtn.addEventListener('click', () => {
                    if (state.kgSelectedYard) toggleFavoriteYard(state.kgSelectedYard);
                });
            }

            if (els.kgSpeakYardBtn) {
                els.kgSpeakYardBtn.addEventListener('click', () => {
                    if (!state.kgSelectedYard) return;
                    const yardRecs = state.rawRecords.filter(r => r.market === state.kgSelectedYard).slice(0, 4);
                    const unitTxt = state.priceUnit === 'mann' ? '૨૦ કિલોના' : '૧૦૦ કિલોના';
                    const details = yardRecs.map(r => `${getGujaratiName(r.commodity)} ${rawConvertedPrice(r.modal_price)} રૂપિયા`).join(', ');
                    speakGujarati(`${getGujaratiName(state.kgSelectedYard)} માર્કેટ યાર્ડના ${unitTxt} ભાવ: ${details}`);
                });
            }

            if (els.kgShareWhatsAppBtn) {
                els.kgShareWhatsAppBtn.addEventListener('click', () => {
                    if (!state.kgSelectedYard) return;
                    const yardRecs = state.rawRecords.filter(r => r.market === state.kgSelectedYard);
                    const unitTxt = state.priceUnit === 'mann' ? '૨૦ કિલો (મણ)' : '૧૦૦ કિલો';
                    const lines = yardRecs.map(r => `• ${getGujaratiName(r.commodity)}: ₹${formatPrice(r.min_price)} થી ₹${formatPrice(r.max_price)}`).join('\n');
                    const shareText = `🌾 *${getGujaratiName(state.kgSelectedYard)} માર્કેટ યાર્ડ ભાવ* (${unitTxt})\n\n${lines}`;
                    window.open(`https://wa.me/?text=${encodeURIComponent(shareText)}`, '_blank');
                });
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            renderVisualCropButtons();
            initEventListeners();
            loadMandiData('live');
        });
    </script>
</body>
</html>
