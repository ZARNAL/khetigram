            else if (state.activeMode === 'two_days_ago') dateTxt = `૨ દિવસ પહેલા (${formatDateDDMMYYYY(getDateDaysAgo(2))})`;
            else if (state.activeMode === 'specific_date') dateTxt = `તારીખ ${isoToDDMMYYYY(els.specificDateInput.value)}`;
            if (els.activeDateSubtitle) {
                els.activeDateSubtitle.textContent = `${dateTxt} • ${unitTxt}`;
            }
